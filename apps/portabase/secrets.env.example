# Secrets du dashboard Portabase. Générer chaque valeur avec : openssl rand -hex 32
# Copier en secrets.enc.env, remplir, puis : sops encrypt -i apps/portabase/secrets.enc.env
# PROJECT_SECRET : chiffre les données sensibles et les échanges avec les agents. Ne pas le
# changer après la mise en service.
PROJECT_SECRET=
POSTGRES_PASSWORD=
# Même mot de passe que POSTGRES_PASSWORD (hexadécimal : rien à échapper dans l'URL)
DATABASE_URL=postgresql://portabase:<POSTGRES_PASSWORD>@db:5432/portabase?schema=public
